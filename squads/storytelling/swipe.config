swipe_sources:
  - moth_radio_hour
  - ted_talks
  - storybrand_podcast
  - business_of_story_podcast
  - story_grid_podcast
  - pitch_deck_databases
  - brand_manifestos
  - commencement_speeches

curation_rules:
  - proven_stories_only
  - tag_by_type_and_emotion
  - tag_by_framework_used
  - tag_by_channel_and_format
  - include_context_and_analysis
  - never_include_copyrighted_content_verbatim
  - include_structural_breakdown

tagging_schema:
  type:
    - valor
    - fundador
    - cliente
    - proposito
    - produto
    - dados
    - origem
    - transformacao
  emotion:
    - esperanca
    - medo
    - curiosidade
    - urgencia
    - pertencimento
    - admiracao
    - empatia
    - surpresa
  channel:
    - social
    - email
    - video
    - deck
    - pitch
    - webinar
    - ad
    - blog
    - podcast
    - print
  framework:
    - heros-journey
    - save-the-cat
    - story-circle
    - storybrand
    - sparkline
    - abt
    - public-narrative
    - gap-bridge
    - pitch-frames
  format:
    - micro-story
    - long-form
    - script
    - outline
    - beat-sheet
    - speech
    - manifesto
  industry:
    - saas
    - ecommerce
    - infoproduct
    - b2b
    - nonprofit
    - startup
    - healthcare
    - finance
    - education

quality_threshold:
  min_analysis_depth: detailed
  must_include_structural_breakdown: true
  must_tag_framework: true
  must_tag_emotion: true
  must_include_marketing_application: true
